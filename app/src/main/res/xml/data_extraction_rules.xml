<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for Android 12+ (dataExtractionRules) -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude recordings from cloud backup (they can be large) -->
        <exclude domain="file" path="recordings/" />
        <!-- Exclude API keys from backup -->
        <exclude domain="sharedpref" path="mindecho_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow full device-to-device transfer -->
        <include domain="file" path="recordings/" />
        <include domain="sharedpref" path="mindecho_prefs.xml" />
    </device-transfer>
</data-extraction-rules>